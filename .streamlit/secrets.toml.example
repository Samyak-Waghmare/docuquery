# .streamlit/secrets.toml.example
# ─────────────────────────────────────────────────────────────────────────────
# This file is the TEMPLATE for Streamlit Cloud secrets.
# On Streamlit Cloud: paste the contents (with real values) into
#   Settings → Secrets
# Locally: copy to .streamlit/secrets.toml (already in .gitignore)
# ─────────────────────────────────────────────────────────────────────────────

GEMINI_API_KEY   = "your_gemini_api_key_here"

QDRANT_URL       = "https://your-cluster-id.aws.cloud.qdrant.io:6333"
QDRANT_API_KEY   = "your_qdrant_cloud_api_key_here"

QDRANT_COLLECTION = "docuquery_vectors"
