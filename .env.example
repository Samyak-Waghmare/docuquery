# ─── DocuQuery Environment Variables ─────────────────────────────────────────
# Copy this file to .env and fill in your actual keys.
# NEVER commit .env to git.

# ── Gemini API ────────────────────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Qdrant ────────────────────────────────────────────────────────────────────
# For LOCAL development (Docker): leave as-is
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# For CLOUD deployment (Qdrant Cloud free tier):
# Sign up at https://cloud.qdrant.io → create cluster → copy URL + API key
# QDRANT_URL=https://xxxx-xxxx.aws.cloud.qdrant.io:6333
# QDRANT_API_KEY=your_qdrant_cloud_api_key_here

# ── Collection Name ───────────────────────────────────────────────────────────
QDRANT_COLLECTION=docuquery_vectors
